---
/**
 * FeatureGrid — a heading and a grid of short promises.
 */
export interface Props {
  id?: string;
  eyebrow?: string;
  heading: string;
  subheading?: string;
  items: { title: string; body: string }[];
}

const { id, eyebrow, heading, subheading, items } = Astro.props;
---
<section class="features" id={id}>
  <div class="inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{heading}</h2>
    {subheading && <p class="sub">{subheading}</p>}
    <ul>
      {items.map((it) => (
        <li>
          <span class="mark" aria-hidden="true"></span>
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features { padding: var(--space-section) var(--space-gutter); }
  .inner { max-width: var(--width-content); margin: 0 auto; }
  .eyebrow { color: var(--color-accent); font-weight: 600; font-size: 0.875rem; margin: 0 0 0.75rem; }
  h2 { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); font-size: clamp(2rem, 4.5vw, 3.25rem); line-height: 1.08; margin: 0; max-width: 40rem; text-wrap: balance; }
  .sub { color: var(--color-muted); font-size: 1.125rem; margin: 1rem 0 0; max-width: 40rem; }
  ul { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 2rem 2.5rem; }
  .mark { display: block; width: 2rem; height: 0.25rem; border-radius: 999px; background: var(--color-highlight); }
  h3 { font-size: 1.125rem; margin: 1rem 0 0.375rem; }
  p { color: var(--color-muted); margin: 0; }
</style>
