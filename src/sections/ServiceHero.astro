---
/**
 * ServiceHero — headline, trust points and two calls to action, with a photo.
 */
export interface Props {
  heading: string;
  subheading?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  trust?: string[];
  imageAlt?: string;
  align?: 'left' | 'center';
}

const { heading, subheading, primaryLabel, primaryHref, secondaryLabel, secondaryHref, trust = [], imageAlt = '', align = 'left' } = Astro.props;
---
<section class="service-hero" data-align={align} id="top">
  <div class="inner">
    <div class="copy">
      <h1>{heading}</h1>
      {subheading && <p class="sub">{subheading}</p>}
      <div class="ctas">
        <a class="primary" href={primaryHref}>{primaryLabel}</a>
        {secondaryLabel && secondaryHref && <a class="secondary" href={secondaryHref}>{secondaryLabel}</a>}
      </div>
      {trust.length > 0 && <ul class="trust">{trust.map((t) => <li>{t}</li>)}</ul>}
    </div>
    {align === 'left' && <div class="photo" role="img" aria-label={imageAlt}></div>}
  </div>
</section>

<style>
  .service-hero { padding: clamp(3rem, 7vw, 6rem) var(--space-gutter); }
  .inner { max-width: var(--width-content); margin: 0 auto; display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  [data-align='center'] .inner { grid-template-columns: 1fr; text-align: center; max-width: 48rem; }
  h1 { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); font-size: clamp(2.25rem, 5.5vw, 4rem); line-height: 1.05; margin: 0; text-wrap: balance; }
  .sub { color: var(--color-muted); font-size: 1.125rem; margin: 1.25rem 0 0; max-width: 34rem; }
  [data-align='center'] .sub { margin-inline: auto; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  [data-align='center'] .ctas { justify-content: center; }
  .ctas a { text-decoration: none; font-weight: 600; border-radius: var(--radius); padding: 0.875rem 1.375rem; }
  .primary { background: var(--color-accent); color: var(--color-accent-text); }
  .secondary { color: var(--color-accent); border: 1px solid var(--color-border); background: var(--color-surface); }
  .trust { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; color: var(--color-muted); font-size: 0.9375rem; }
  .trust li::before { content: '✓'; color: var(--color-accent); font-weight: 700; margin-right: 0.375rem; }
  .photo { aspect-ratio: 4 / 3.4; border-radius: var(--radius-lg); background: linear-gradient(150deg, var(--color-surface-2) 0%, color-mix(in srgb, var(--color-accent) 35%, var(--color-surface-2)) 100%); box-shadow: var(--shadow-lg); }
  @media (max-width: 820px) { .inner { grid-template-columns: 1fr; } }
</style>
