---
/**
 * Faq — common questions as expandable rows.
 */
export interface Props {
  id?: string;
  heading: string;
  items: { q: string; a: string }[];
}

const { id, heading, items } = Astro.props;
---
<section class="faq" id={id}>
  <div class="inner">
    <h2>{heading}</h2>
    <div class="list">
      {items.map((it, i) => (
        <details open={i === 0}>
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding: var(--space-section) var(--space-gutter); background: var(--color-surface-2); }
  .inner { max-width: 48rem; margin: 0 auto; }
  h2 { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); font-size: clamp(1.875rem, 4vw, 2.75rem); line-height: 1.1; margin: 0; text-align: center; }
  .list { margin-top: 2.5rem; display: grid; gap: 0.75rem; }
  details { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.25rem; }
  summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--color-accent); font-weight: 700; }
  details[open] summary::after { content: '−'; }
  details p { color: var(--color-muted); margin: 0.75rem 0 0; }
</style>
