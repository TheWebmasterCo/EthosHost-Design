---
/**
 * SiteHeader — wordmark, a few links, one call to action.
 */
export interface Props {
  links?: { label: string; href: string }[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  links = [],
  ctaLabel,
  ctaHref,
} = Astro.props;
---
<header class="site-header">
  <div class="inner">
    <a class="wordmark" href="/" aria-label="EthosHost home">
      <span class="ethos">Ethos</span><span class="host">Host</span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      {ctaLabel && ctaHref && <a class="cta" href={ctaHref}>{ctaLabel}</a>}
    </nav>
  </div>
</header>

<style>
  .site-header { padding: 1.25rem var(--space-gutter); }
  .inner { max-width: var(--width-content); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .wordmark { text-decoration: none; color: var(--color-text); font-size: 1.5rem; line-height: 1; }
  .ethos { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); }
  .host { font-family: var(--font-body); font-weight: 400; color: var(--color-muted); margin-left: 0.05em; }
  nav { display: flex; align-items: center; gap: 1.5rem; }
  nav a { color: var(--color-muted); text-decoration: none; font-size: 0.9375rem; }
  nav a:hover { color: var(--color-text); }
  nav a.cta { color: var(--color-accent-text); background: var(--color-accent); padding: 0.5rem 1rem; border-radius: 999px; font-weight: 600; }
  @media (max-width: 640px) {
    nav a:not(.cta) { display: none; }
  }
</style>
