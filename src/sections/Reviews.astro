---
/**
 * Reviews — customer quotes with an overall rating.
 */
export interface Props {
  id?: string;
  heading: string;
  rating?: string;
  ratingNote?: string;
  items: { quote: string; name: string; detail?: string }[];
}

const { id, heading, rating, ratingNote, items } = Astro.props;
---
<section class="reviews" id={id}>
  <div class="inner">
    <div class="head">
      <h2>{heading}</h2>
      {rating && <p class="rating"><span aria-hidden="true">★★★★★</span> <b>{rating}</b> {ratingNote}</p>}
    </div>
    <ul>
      {items.map((r) => (
        <li>
          <blockquote>“{r.quote}”</blockquote>
          <p class="who"><b>{r.name}</b>{r.detail && <span> · {r.detail}</span>}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews { padding: var(--space-section) var(--space-gutter); }
  .inner { max-width: var(--width-content); margin: 0 auto; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; }
  h2 { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); font-size: clamp(1.875rem, 4vw, 2.75rem); line-height: 1.1; margin: 0; }
  .rating { margin: 0; color: var(--color-muted); }
  .rating span { color: var(--color-highlight); letter-spacing: 0.1em; }
  .rating b { color: var(--color-text); }
  ul { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1.25rem; }
  li { border-top: 3px solid var(--color-highlight); background: var(--color-surface); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); }
  blockquote { margin: 0; font-size: 1.0625rem; }
  .who { margin: 1.25rem 0 0; font-size: 0.875rem; color: var(--color-muted); }
  .who b { color: var(--color-text); }
</style>
